{
    "name": "ruudk/symfony-config-code-generator",
    "description": "Transform ContainerBuilder configurations into modern Symfony configuration files with zero effort",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ruud Kamphuis",
            "email": "ruudk@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ruudk/code-generator": "^0.4.5",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.61",
        "ergebnis/composer-normalize": "^2.47",
        "phpunit/phpunit": "^13.4",
        "ruudk/readme-examples-sync-hook": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/expression-language": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Ruudk\\SymfonyConfigCodeGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruudk\\SymfonyConfigCodeGenerator\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "command -v lefthook >/dev/null 2>&1 && lefthook install || true"
        ]
    }
}
